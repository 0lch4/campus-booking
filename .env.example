# Copy to .env and adjust

# Postgres
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
POSTGRES_DB=campus_booking
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
# At least 32 chars, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-string-of-32-chars
JWT_EXPIRE_MINUTES=60
